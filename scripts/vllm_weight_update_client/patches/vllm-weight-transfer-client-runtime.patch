+def parse_weight_transfer_config(val: str) -> WeightTransferConfig:
+    """Parse CLI JSON into the config class selected by ``backend``.
+
+    ``_compute_kwargs`` normally validates dataclass-valued arguments against
+    the field's annotated type.  For weight transfer that type is the base
+    config, which necessarily rejects backend-specific wire parameters such as
+    ``packed`` before ``EngineArgs.__post_init__`` can dispatch to the concrete
